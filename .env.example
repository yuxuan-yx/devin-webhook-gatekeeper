# Required by the webhook service: the shared secret configured on the GitHub
# webhook, verified as HMAC-SHA256 over the raw request body.
GITHUB_WEBHOOK_SECRET=

# Required by every process. The key is a service-user API key or PAT
# (prefix cog_); DEVIN_ORG_ID is the org those sessions belong to (prefix org-).
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai/v3

PLAYBOOK_ID_CI_FAILURE=
PLAYBOOK_ID_ISSUE_TRIAGE=
PLAYBOOK_ID_SECURITY=
KNOWLEDGE_ID_REPO_CONTEXT=

# Scanner ingress (/events/scan). Separate from the GitHub secret so a
# compromised scanner integration cannot forge GitHub events; falls back to
# GITHUB_WEBHOOK_SECRET when unset.
SCAN_WEBHOOK_SECRET=

# Budget kill-switch: sessions this instance may dispatch per UTC day. Beyond
# it, otherwise acceptable events are dropped with reason daily_cap_exceeded.
MAX_DAILY_SESSIONS=20

# ROI / impact estimates (hours). Used by /metrics to compute engineering time saved.
HUMAN_HOURS_CI_FAILURE=2.0
HUMAN_HOURS_ISSUE_TRIAGE=1.0
HUMAN_HOURS_SECURITY=4.0
HUMAN_HOURS_VULN_SCAN=3.0

# Governance. JSON arrays. Point this at your Superset fork when demoing.
ALLOWED_REPOSITORIES=["apache/superset"]
ALLOWED_ISSUE_LABELS=["needs-devin-triage","security-cve"]

LOG_LEVEL=INFO
